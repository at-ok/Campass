DATABASE_URL="postgresql://user:password@host:port/database"
# Optional direct Neon connection for migrations (pooling disabled)
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:port/database"
BETTER_AUTH_SECRET="put_a_random_string_here"
# BETTER_AUTH_URL="http://localhost:3000" # In production: https://your-project.vercel.app
PORT=3000

# Google OAuth (optional - for Google login)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your_google_client_id"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"
